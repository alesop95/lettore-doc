# ── Ambiente Python virtuale ──────────────────────────────
.venv/

# ── File intermedi della pipeline (rigenerabili) ──────────
_intermediate/

# ── Vault Obsidian generato (rigenerabile) ────────────────
vault-output/

# ── Variabili di ambiente locali (mai committare) ─────────
.env
.env.local

# ── Cartelle graphify-out (dove capita) ───────────────────
graphify-out/
**/graphify-out/

# ── Cartelle di test locali ───────────────────────────────
*-copy-prova/
*-test/
_tmp_*/

# ── Obsidian ──────────────────────────────────────────────
.obsidian/

# ── Cache Python ──────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/

# ── IDE ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Sistema operativo ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── File temporanei Word ──────────────────────────────────
~$*.docx
~$*.doc


# Altri file e cartelle da ignorare
_notes/

# ── Cartelle non sanitizzate escluse anche dalla scansione graphify ───
# Documenti aziendali reali (policy IT), presenti in _intermediate/src/ ma
# non ancora sanitizzati per la tassonomia pubblica. Gia' esclusi da git
# via _intermediate/ a monte: qui la regola e' esplicita per simmetria con
# .graphifyignore e come documentazione della decisione.
_intermediate/src/Cybersec-governance-baseline/

# Backup automatici del diario prodotti da append_diary_section.py
*.bak.docx
_intermediate/src/Cybersec-endpoint-governance/
